# Cloudflare Workers static-asset headers (copied into out/ by the export).

# Frames live under a version folder (/frames/v1/…), so they never change at a
# given URL: cache for a year. A re-render must bump VERSION in
# scripts/build-frames.mjs.
/frames/*
  Cache-Control: public, max-age=31536000, immutable

# Next's build output (JS, CSS, the logo) is content-hashed.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Posters aren't versioned: a week, refreshed in the background.
/posters/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
